{% extends "base.html.j2" %}
{% block title %}Koreksi Data - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Administrasi / Koreksi Data{% endblock %}

{% block content %}
<div class="mb-4 flex flex-wrap gap-2">
    <button onclick="showTab('voidTab')" id="btnVoid" class="px-4 py-2 rounded-xl text-sm bg-primary-600 text-white">Void Pembayaran</button>
    <button onclick="showTab('editTab')" id="btnEdit" class="px-4 py-2 rounded-xl text-sm bg-slate-100 text-slate-600">Koreksi Tagihan</button>
    <button onclick="showTab('auditTab')" id="btnAudit" class="px-4 py-2 rounded-xl text-sm bg-slate-100 text-slate-600">Log Audit</button>
</div>

<div id="voidTab" class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm">
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">No</th>
                <th class="text-left px-4 py-3">Tanggal</th>
                <th class="text-left px-4 py-3">Siswa</th>
                <th class="text-right px-4 py-3">Jumlah</th>
                <th class="text-center px-4 py-3">Status</th>
                <th class="text-left px-4 py-3">Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for p in payments %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3">{{ p.payment_no }}</td>
                <td class="px-4 py-3">{{ p.payment_date.strftime('%d/%m/%Y') if p.payment_date else '-' }}</td>
                <td class="px-4 py-3">{{ p.student.name if p.student else '-' }}</td>
                <td class="px-4 py-3 text-right">Rp {{ "{:,.0f}".format(p.amount_paid) }}</td>
                <td class="px-4 py-3 text-center">
                    <span class="text-xs px-2 py-1 rounded-full {{ 'bg-rose-100 text-rose-700' if p.is_voided else 'bg-emerald-100 text-emerald-700' }}">
                        {{ 'Void' if p.is_voided else 'Aktif' }}
                    </span>
                </td>
                <td class="px-4 py-3">
                    {% if not p.is_voided %}
                    <button onclick="voidPayment('{{ p._id }}', '{{ p.payment_no }}')"
                        class="text-red-600 text-xs hover:text-red-800">Void</button>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>

<div id="editTab" class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm hidden">
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">Siswa</th>
                <th class="text-left px-4 py-3">Komponen</th>
                <th class="text-right px-4 py-3">Tagihan</th>
                <th class="text-center px-4 py-3">Status</th>
                <th class="text-left px-4 py-3">Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for inv in invoices %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3">{{ inv.student.name if inv.student else '-' }}</td>
                <td class="px-4 py-3">{{ inv.component.name if inv.component else '-' }}</td>
                <td class="px-4 py-3 text-right">Rp {{ "{:,.0f}".format(inv.total_amount) }}</td>
                <td class="px-4 py-3 text-center">{{ inv.status }}</td>
                <td class="px-4 py-3">
                    <button onclick="editInvoice('{{ inv._id }}', '{{ inv.total_amount }}', '{{ inv.status }}')"
                        class="text-blue-600 text-xs hover:text-blue-800">Koreksi</button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>

<div id="auditTab" class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm hidden">
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">Waktu</th>
                <th class="text-left px-4 py-3">User</th>
                <th class="text-left px-4 py-3">Aksi</th>
                <th class="text-left px-4 py-3">Tabel</th>
                <th class="text-left px-4 py-3">Catatan</th>
            </tr>
        </thead>
        <tbody>
            {% for log in audit_logs %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3 text-xs">{{ log.created_at.strftime('%d/%m/%Y %H:%M') if log.created_at else '-' }}</td>
                <td class="px-4 py-3">{{ log.user_email }}</td>
                <td class="px-4 py-3">{{ log.action }}</td>
                <td class="px-4 py-3">{{ log.table_name }}</td>
                <td class="px-4 py-3 text-xs">{{ log.notes }}</td>
            </tr>
            {% endfor %}
            {% if not audit_logs %}
            <tr><td colspan="5" class="text-center py-8 text-slate-400">Belum ada log audit</td></tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>

<!-- Void Modal -->
<div id="voidModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden overflow-y-auto">
    <div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm w-full max-w-sm mx-4">
        <h3 class="font-semibold text-lg mb-4">Void Pembayaran</h3>
        <p id="voidPaymentInfo" class="text-sm text-slate-600 mb-3"></p>
        <form method="post" id="voidForm" class="space-y-3">
            <textarea name="reason" placeholder="Alasan void..." required rows="3"
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm"></textarea>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeModal('voidModal')" class="px-4 py-2 border rounded-xl text-sm">Batal</button>
                <button type="submit" class="px-4 py-2 bg-red-700 text-white rounded-xl text-sm">Void</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Invoice Modal -->
<div id="editInvoiceModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden overflow-y-auto">
    <div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm w-full max-w-sm mx-4">
        <h3 class="font-semibold text-lg mb-4">Koreksi Tagihan</h3>
        <form method="post" id="editInvoiceForm" class="space-y-3">
            <input type="number" name="total_amount" id="editInvoiceAmount" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <select name="status" id="editInvoiceStatus" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="draft">Draft</option>
                <option value="posted">Posted</option>
                <option value="paid">Paid</option>
                <option value="cancelled">Cancelled</option>
            </select>
            <textarea name="notes" placeholder="Alasan koreksi..." rows="2"
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm"></textarea>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeModal('editInvoiceModal')" class="px-4 py-2 border rounded-xl text-sm">Batal</button>
                <button type="submit" class="px-4 py-2 bg-primary-600 text-white rounded-xl text-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>

<script>
function showTab(tab) {
    ['voidTab', 'editTab', 'auditTab'].forEach(function(t) {
        document.getElementById(t).classList.add('hidden');
        document.getElementById('btn' + t.charAt(0).toUpperCase() + t.slice(1).replace('Tab', '')).className =
            'px-4 py-2 rounded-xl text-sm bg-slate-100 text-slate-600';
    });
    document.getElementById(tab).classList.remove('hidden');
    var btnId = 'btn' + tab.charAt(0).toUpperCase() + tab.slice(1).replace('Tab', '');
    document.getElementById(btnId).className = 'px-4 py-2 rounded-xl text-sm bg-primary-600 text-white';
}
function voidPayment(id, no) {
    document.getElementById('voidForm').action = '/admin/koreksi/void-payment/' + id;
    document.getElementById('voidPaymentInfo').textContent = 'Pembayaran: ' + no;
    document.getElementById('voidModal').classList.remove('hidden');
}
function editInvoice(id, amount, status) {
    document.getElementById('editInvoiceForm').action = '/admin/koreksi/edit-invoice/' + id;
    document.getElementById('editInvoiceAmount').value = amount;
    document.getElementById('editInvoiceStatus').value = status;
    document.getElementById('editInvoiceModal').classList.remove('hidden');
}
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
</script>
<script>lucide.createIcons();</script>
{% endblock %}
