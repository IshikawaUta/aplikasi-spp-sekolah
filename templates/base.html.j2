<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}Aplikasi SPP Sekolah{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { 50: '#eef2ff', 100: '#e0e7ff', 200: '#c7d2fe', 300: '#a5b4fc', 400: '#818cf8', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 800: '#3730a3', 900: '#312e81' },
                    },
                    fontFamily: { sans: ['Outfit', 'sans-serif'] },
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="https://img.icons8.com/?size=100&id=115369&format=png&color=000000">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .glass-dark {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .hover-lift {
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .hover-lift:hover {
            transform: translateY(-4px);
        }
        .sidebar-open { transform: translateX(0) !important; }
        .overlay-visible { opacity: 1 !important; pointer-events: auto !important; }
        body.sidebar-locked { overflow: hidden; }

        @media (max-width: 1023px) {
            .sidebar-mobile { transform: translateX(-100%); }
        }
        .dark body, body.dark {
            background: radial-gradient(circle at top right, #0f172a 0%, #1e1b4b 100%) !important;
            background-attachment: fixed !important;
        }
        .dark .glass {
            background: rgba(30, 41, 59, 0.7) !important;
            border-color: rgba(255, 255, 255, 0.06) !important;
        }
        .dark .text-slate-900, .dark .text-slate-800 { color: #e2e8f0 !important; }
        .dark .text-slate-700 { color: #cbd5e1 !important; }
        .dark .text-slate-600 { color: #94a3b8 !important; }
        .dark .text-slate-500, .dark .text-slate-400 { color: #64748b !important; }
        .dark .border-white\/60, .dark .border-white\/40, .dark .border-white\/30 { border-color: rgba(255,255,255,0.06) !important; }
        .dark .bg-slate-100, .dark .bg-gray-50, .dark .bg-gray-100 { background: rgba(30, 41, 59, 0.8) !important; }
        .dark .bg-slate-900\/5 { background: rgba(255,255,255,0.05) !important; }
        .dark .bg-white\/60 { background: rgba(30, 41, 59, 0.5) !important; }
        .dark .bg-white\/50 { background: rgba(30, 41, 59, 0.4) !important; }
        .dark .bg-primary-50 { background: rgba(79, 70, 229, 0.15) !important; }
        .dark .bg-emerald-100 { background: rgba(16, 185, 129, 0.15) !important; }
        .dark .bg-amber-100 { background: rgba(245, 158, 11, 0.15) !important; }
        .dark .bg-rose-100 { background: rgba(244, 63, 94, 0.15) !important; }
        .dark .text-slate-800, .dark .text-slate-900 { color: #f1f5f9 !important; }
        .dark .divide-white\/40 > * { border-color: rgba(255,255,255,0.06) !important; }
        .dark input, .dark select, .dark textarea { background: rgba(30,41,59,0.5) !important; color: #e2e8f0 !important; border-color: rgba(255,255,255,0.1) !important; }
        .dark input::placeholder, .dark textarea::placeholder { color: #64748b !important; }
        .dark .hover\:bg-white\/50:hover { background: rgba(255,255,255,0.08) !important; }
        .dark .hover\:bg-white\/60:hover { background: rgba(255,255,255,0.08) !important; }
        .dark .hover\:bg-white\/10:hover { background: rgba(255,255,255,0.06) !important; }
        @media print {
            .no-print { display: none !important; }
            .glass, .glass-dark { background: white !important; backdrop-filter: none !important; border: none !important; }
        }
    </style>
    {% block head_extra %}{% endblock %}
</head>
<body class="min-h-screen text-slate-800" style="background: radial-gradient(circle at top right, #fdfcfb 0%, #e2d1c3 100%); background-attachment: fixed;">
    <!-- Sidebar Overlay (mobile) -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/40 z-30 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden no-print" onclick="closeSidebar()"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="no-print fixed top-0 left-0 bottom-0 w-72 glass rounded-r-[32px] shadow-xl z-40 flex flex-col overflow-hidden sidebar-mobile lg:transform-none lg:rounded-[32px] lg:top-4 lg:left-4 lg:bottom-4 transition-transform duration-300">
        <div class="p-5 border-b border-white/30 flex items-center justify-between">
            <div>
                <h1 class="text-lg font-black text-slate-900">{{ config.APP_NAME }}</h1>
                <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Sistem Pembayaran SPP</p>
            </div>
            <button onclick="closeSidebar()" class="lg:hidden w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200 transition">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
            {% set nav_hover = 'text-slate-600 dark:text-slate-300 hover:bg-white/60 hover:text-slate-900 dark:hover:bg-white/10 dark:hover:text-white' %}
            <a href="/" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'dashboard' else nav_hover }}">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                Dashboard
            </a>

            <div class="px-3 pt-4 pb-1 text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Master Data</div>
            <a href="/master/siswa" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'siswa' else nav_hover }}">
                <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                Siswa
            </a>
            <a href="/master/siswa/import" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'import_siswa' else nav_hover }}">
                <i data-lucide="upload" class="w-5 h-5"></i>
                Import Siswa
            </a>
            <a href="/master/kelas" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'kelas' else nav_hover }}">
                <i data-lucide="school" class="w-5 h-5"></i>
                Kelas
            </a>
            <a href="/master/komponen" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'komponen' else nav_hover }}">
                <i data-lucide="list-checks" class="w-5 h-5"></i>
                Komponen
            </a>
            <a href="/master/periode" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'periode' else nav_hover }}">
                <i data-lucide="calendar-range" class="w-5 h-5"></i>
                Periode
            </a>
            <a href="/master/kenaikan-kelas" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'kenaikan_kelas' else nav_hover }}">
                <i data-lucide="arrow-up" class="w-5 h-5"></i>
                Kenaikan Kelas
            </a>

            <div class="px-3 pt-4 pb-1 text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Transaksi</div>
            <a href="/tagihan/" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'tagihan' else nav_hover }}">
                <i data-lucide="file-text" class="w-5 h-5"></i>
                Tagihan
            </a>
            <a href="/tagihan/generate" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'tagihan_generate' else nav_hover }}">
                <i data-lucide="sparkles" class="w-5 h-5"></i>
                Generate Tagihan
            </a>
            <a href="/pembayaran/" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'pembayaran' else nav_hover }}">
                <i data-lucide="credit-card" class="w-5 h-5"></i>
                Pembayaran
            </a>
            <a href="/pembayaran/virtual-akun" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'va' else nav_hover }}">
                <i data-lucide="landmark" class="w-5 h-5"></i>
                Virtual Account
            </a>

            <div class="px-3 pt-4 pb-1 text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Laporan</div>
            <a href="/laporan/" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'laporan' else nav_hover }}">
                <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                Ringkasan
            </a>
            <a href="/laporan/tunggakan" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'tunggakan' else nav_hover }}">
                <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                Tunggakan
            </a>
            <a href="/laporan/mutasi" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'mutasi' else nav_hover }}">
                <i data-lucide="arrow-left-right" class="w-5 h-5"></i>
                Mutasi
            </a>
            <a href="/laporan/kartu-spp" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'kartu_spp' else nav_hover }}">
                <i data-lucide="id-card" class="w-5 h-5"></i>
                Kartu SPP
            </a>
            <a href="/laporan/rekap-harian" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'rekap_harian' else nav_hover }}">
                <i data-lucide="clipboard-list" class="w-5 h-5"></i>
                Rekap Harian
            </a>

            <div class="px-3 pt-4 pb-1 text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Admin</div>
            <a href="/admin/pengguna" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'pengguna' else nav_hover }}">
                <i data-lucide="users" class="w-5 h-5"></i>
                Pengguna
            </a>
            <a href="/admin/koreksi" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'koreksi' else nav_hover }}">
                <i data-lucide="wrench" class="w-5 h-5"></i>
                Koreksi
            </a>
            <a href="/admin/rekening" class="flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all {{ 'bg-primary-50 text-primary-600' if active_page == 'rekening' else nav_hover }}">
                <i data-lucide="building-2" class="w-5 h-5"></i>
                Rekening
            </a>
        </nav>
        <div class="p-3 border-t border-white/30">
            <div class="flex items-center gap-3 px-4 py-2">
                <div class="w-8 h-8 bg-primary-100 text-primary-600 rounded-xl flex items-center justify-center text-xs font-black">
                    {{ session.user_name[0] if session.user_name else '?' }}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-slate-800 truncate">{{ session.user_name }}</p>
                    <p class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">{{ session.user_role }}</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="lg:ml-72 min-h-screen flex flex-col pb-20 lg:pb-6">
        <!-- Top Bar -->
        <header class="no-print glass rounded-none lg:rounded-[28px] lg:mx-6 lg:mt-6 px-4 lg:px-6 py-3 lg:py-4 flex items-center justify-between shadow-sm z-20 sticky top-0 lg:relative">
            <div class="flex items-center gap-3">
                <button onclick="openSidebar()" class="lg:hidden w-9 h-9 rounded-xl bg-white/60 flex items-center justify-center text-slate-600 active:scale-95 transition">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
                <div class="relative hidden sm:block flex-1 max-w-md">
                    <input type="text" id="globalSearch" placeholder="Cari siswa..."
                        class="w-full bg-white/40 border border-white/40 rounded-xl pl-9 pr-4 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500 focus:bg-white transition"
                        oninput="searchSiswa(this.value)" onfocus="document.getElementById('searchResults')?.classList.remove('hidden')"
                        onblur="setTimeout(()=>document.getElementById('searchResults')?.classList.add('hidden'),200)">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <div id="searchResults" class="hidden absolute top-full left-0 right-0 mt-1 glass rounded-2xl shadow-xl border border-white/60 overflow-hidden z-50"></div>
                </div>
                <h2 class="text-sm lg:text-base font-bold text-slate-700">{% block header_title %}{% endblock %}</h2>
            </div>
            <div class="flex items-center gap-2 lg:gap-3">
                <button onclick="toggleTheme()" class="w-9 h-9 rounded-xl bg-white/60 flex items-center justify-center text-slate-500 hover:text-primary-600 active:scale-95 transition" id="themeToggle">
                    <i data-lucide="moon" class="w-4 h-4 hidden dark:inline-block"></i>
                    <i data-lucide="sun" class="w-4 h-4 dark:hidden"></i>
                </button>
                <span class="text-xs text-slate-400 font-medium hidden sm:inline">{{ session.user_name }}</span>
                <div class="w-px h-6 bg-slate-200 hidden sm:block"></div>
                <a href="/auth/logout" class="flex items-center gap-1.5 text-xs font-bold text-rose-500 hover:text-rose-600 transition px-2 lg:px-3 py-1.5 rounded-xl hover:bg-rose-50 active:scale-95">
                    <i data-lucide="log-out" class="w-4 h-4"></i><span class="hidden sm:inline">Keluar</span>
                </a>
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 p-4 lg:p-6 animate__animated animate__fadeIn">
            {% block content %}{% endblock %}
        </main>
    </div>

    <!-- Bottom Navigation (mobile only) -->
    <nav class="no-print lg:hidden fixed bottom-0 left-0 right-0 glass border-t border-white/60 z-50 px-2 py-1.5" style="padding-bottom: max(0.375rem, env(safe-area-inset-bottom));">
        <div class="flex items-center justify-around max-w-lg mx-auto">
            <a href="/" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition {{ 'text-primary-600' if active_page == 'dashboard' else 'text-slate-400 dark:text-slate-500 hover:text-primary-500 dark:hover:text-white' }}">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                <span class="text-[10px] font-bold">Home</span>
            </a>
            <a href="/tagihan/" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition {{ 'text-primary-600' if active_page == 'tagihan' else 'text-slate-400 dark:text-slate-500 hover:text-primary-500 dark:hover:text-white' }}">
                <i data-lucide="file-text" class="w-5 h-5"></i>
                <span class="text-[10px] font-bold">Tagihan</span>
            </a>
            <a href="/pembayaran/" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition {{ 'text-primary-600' if active_page == 'pembayaran' else 'text-slate-400 dark:text-slate-500 hover:text-primary-500 dark:hover:text-white' }}">
                <i data-lucide="credit-card" class="w-5 h-5"></i>
                <span class="text-[10px] font-bold">Bayar</span>
            </a>
            <a href="/laporan/" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition {{ 'text-primary-600' if active_page == 'laporan' else 'text-slate-400 dark:text-slate-500 hover:text-primary-500 dark:hover:text-white' }}">
                <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                <span class="text-[10px] font-bold">Laporan</span>
            </a>
            <a href="/master/siswa" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition {{ 'text-primary-600' if active_page == 'siswa' else 'text-slate-400 dark:text-slate-500 hover:text-primary-500 dark:hover:text-white' }}">
                <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                <span class="text-[10px] font-bold">Siswa</span>
            </a>
        </div>
    </nav>

    <!-- Toast Container -->
    <div id="toast" class="fixed top-4 right-4 lg:top-6 lg:right-6 z-50 hidden glass rounded-2xl px-5 py-3 shadow-xl border border-white/60 text-sm font-semibold animate__animated"></div>

    <script>
        (function() {
            if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
        function toggleTheme() {
            var isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            lucide.createIcons();
        }

        lucide.createIcons();

        async function searchSiswa(q) {
            var container = document.getElementById('searchResults');
            if (!q || q.length < 2) { container.classList.add('hidden'); container.innerHTML = ''; return; }
            container.classList.remove('hidden');
            try {
                var resp = await fetch('/api/search-siswa?q=' + encodeURIComponent(q));
                var data = await resp.json();
                if (!data.results.length) {
                    container.innerHTML = '<div class="px-4 py-3 text-sm text-slate-400">Tidak ditemukan</div>';
                    return;
                }
                container.innerHTML = data.results.map(function(s) {
                    return '<a href="/laporan/kartu-spp?student_id=' + s._id + '" class="flex items-center justify-between px-4 py-2.5 hover:bg-white/50 transition text-sm border-b border-white/20 last:border-0">' +
                        '<span><span class="font-semibold text-slate-700">' + s.name + '</span><span class="text-slate-400 ml-2">' + s.nis + '</span></span>' +
                        '<span class="text-[10px] text-slate-400">' + s.angkatan + '</span></a>';
                }).join('');
            } catch(e) { container.innerHTML = '<div class="px-4 py-3 text-sm text-rose-500">Gagal mencari</div>'; }
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('sidebar-open');
            document.getElementById('sidebarOverlay').classList.add('overlay-visible');
            document.body.classList.add('sidebar-locked');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('sidebar-open');
            document.getElementById('sidebarOverlay').classList.remove('overlay-visible');
            document.body.classList.remove('sidebar-locked');
        }

        function showToast(msg, type) {
            var t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'fixed top-4 right-4 lg:top-6 lg:right-6 z-50 glass rounded-2xl px-5 py-3 shadow-xl border border-white/60 text-sm font-semibold animate__animated animate__fadeInRight';
            t.classList.add(type === 'success' ? 'text-emerald-700' : type === 'error' ? 'text-rose-700' : 'text-slate-700');
            t.classList.remove('hidden');
            setTimeout(function(){ t.classList.add('hidden'); }, 3000);
        }

        {% if get_or_create_csrf_token %}
        document.addEventListener('DOMContentLoaded', function() {
            var token = '{{ get_or_create_csrf_token(session) }}';
            document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(function(f) {
                if (!f.querySelector('input[name="_csrf_token"]')) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = '_csrf_token';
                    input.value = token;
                    f.appendChild(input);
                }
            });
        });
        {% endif %}
    </script>
</body>
</html>
