{% extends "base.html.j2" %}
{% block title %}Server Error - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}500 - Server Error{% endblock %}
{% block content %}
<div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center">
        <div class="text-6xl font-bold text-gray-300 mb-4">500</div>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Terjadi Kesalahan</h3>
        <p class="text-gray-500 mb-6">Maaf, terjadi kesalahan pada server. Silakan coba beberapa saat lagi.</p>
        <a href="/" class="inline-block bg-blue-700 text-white px-6 py-2 rounded-lg text-sm hover:bg-blue-800 transition">
            <i data-lucide="home" class="w-4 h-4 inline-block mr-2"></i>Kembali ke Dashboard
        </a>
    </div>
</div>
<script>lucide.createIcons();</script>
{% endblock %}
