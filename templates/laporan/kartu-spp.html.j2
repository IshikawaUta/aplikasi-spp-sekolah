{% extends "base.html.j2" %}
{% block title %}Kartu SPP - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Laporan / Kartu SPP{% endblock %}

{% block head_extra %}
<style>
    @media print {
        body * { visibility: hidden; }
        html, body { margin: 0; padding: 0; }
        #printArea, #printArea * { visibility: visible; }
        #printArea { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none !important; border-radius: 0 !important; }
    }
</style>
{% endblock %}

{% block content %}
<div class="flex flex-wrap gap-2 mb-4">
    <form method="get" action="/laporan/kartu-spp" class="flex flex-wrap gap-2">
        <input type="text" name="search" placeholder="Cari Nama atau NIS" value="{{ request.args.get('search', '') }}"
            class="w-full sm:w-64 px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
        <button type="submit" class="bg-primary-600 text-white px-3 py-1.5 rounded-xl text-xs">Cari</button>
    </form>
</div>

{% if students %}
<div class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm mb-6">
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">Nama</th>
                <th class="text-left px-4 py-3">NIS</th>
                <th class="text-left px-4 py-3">Kelas</th>
                <th class="text-left px-4 py-3">Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for s in students %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3">{{ s.name }}</td>
                <td class="px-4 py-3">{{ s.nis }}</td>
                <td class="px-4 py-3">{{ s.class_name or '-' }}</td>
                <td class="px-4 py-3">
                    <a href="?student_id={{ s._id }}" class="text-primary-600 hover:text-primary-700 text-sm">Lihat Kartu</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

{% if student %}
<div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm" id="printArea">
    <div class="text-center mb-6 border-b pb-4">
        <h2 class="text-xl font-bold">{{ config.APP_NAME }}</h2>
        <p class="text-sm text-slate-500">{{ config.APP_ADDRESS }}</p>
        <h3 class="text-lg font-semibold mt-4">KARTU SPP</h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4 text-sm">
        <div>
            <span class="text-slate-500">Nama:</span>
            <span class="font-medium ml-2">{{ student.name }}</span>
        </div>
        <div>
            <span class="text-slate-500">NIS:</span>
            <span class="font-medium ml-2">{{ student.nis }}</span>
        </div>
        <div>
            <span class="text-slate-500">Angkatan:</span>
            <span class="font-medium ml-2">{{ student.angkatan }}</span>
        </div>
        <div>
            <span class="text-slate-500">Kelas:</span>
            <span class="font-medium ml-2">{{ student.class_name or '-' }}</span>
        </div>
    </div>

    <div class="text-center mb-4">
        <span class="text-lg font-bold px-4 py-1 rounded-full {{ 'bg-emerald-100 text-emerald-700' if all_paid else 'bg-rose-100 text-rose-700' }}">
            {{ 'LUNAS' if all_paid else 'MENUNGGAK' }}
        </span>
    </div>

    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm border">
        <thead class="bg-gray-50">
            <tr>
                <th class="text-left px-3 py-2 border">No</th>
                <th class="text-left px-3 py-2 border">Komponen</th>
                <th class="text-left px-3 py-2 border">Periode</th>
                <th class="text-right px-3 py-2 border">Tagihan</th>
                <th class="text-right px-3 py-2 border">Terbayar</th>
                <th class="text-right px-3 py-2 border">Sisa</th>
                <th class="text-center px-3 py-2 border">Status</th>
            </tr>
        </thead>
        <tbody>
            {% for inv in invoices %}
            <tr>
                <td class="px-3 py-2 border">{{ loop.index }}</td>
                <td class="px-3 py-2 border">{{ inv.component.name if inv.component else '-' }}</td>
                <td class="px-3 py-2 border">{{ inv.period.name if inv.period else '-' }}</td>
                <td class="px-3 py-2 border text-right">Rp {{ "{:,.0f}".format(inv.total_amount) }}</td>
                <td class="px-3 py-2 border text-right">Rp {{ "{:,.0f}".format(inv.paid_amount) }}</td>
                <td class="px-3 py-2 border text-right">Rp {{ "{:,.0f}".format(inv.total_amount - inv.paid_amount) }}</td>
                <td class="px-3 py-2 border text-center">{{ inv.status }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>

{% if payment_history %}
<div class="glass rounded-[32px] p-6 mt-6 border border-white/60 shadow-sm">
    <h3 class="font-black text-slate-900 mb-4">Riwayat Pembayaran</h3>
    <div class="space-y-3">
        {% for p in payment_history %}
        <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/50 transition">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600">
                    <i data-lucide="check" class="w-5 h-5"></i>
                </div>
                <div>
                    <p class="font-semibold text-sm text-slate-700">{{ p.payment_no }}</p>
                    <p class="text-xs text-slate-400">{{ p.components }}</p>
                </div>
            </div>
            <div class="text-right">
                <p class="font-bold text-sm text-emerald-600">Rp {{ "{:,.0f}".format(p.amount_paid) }}</p>
                <p class="text-xs text-slate-400">{{ p.date.strftime('%d/%m/%y %H:%M') if p.date else '' }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<div class="mt-4 flex flex-wrap gap-2">
    <button onclick="window.print()" class="bg-primary-600 text-white px-4 py-2 rounded-xl text-sm inline-flex items-center gap-1.5 font-bold hover:bg-primary-700 transition active:scale-95">
        <i data-lucide="printer" class="w-4 h-4"></i> Cetak
    </button>
    <a href="https://wa.me/?text={{ wa_message }}" target="_blank" class="bg-emerald-600 text-white px-4 py-2 rounded-xl text-sm inline-flex items-center gap-1.5 font-bold hover:bg-emerald-700 transition active:scale-95">
        <i data-lucide="message-circle" class="w-4 h-4"></i> Kirim WA
    </a>
</div>
<script>lucide.createIcons();</script>
{% endif %}
{% endblock %}
