{% extends "base.html.j2" %}
{% block title %}Mutasi Pembayaran - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Laporan / Mutasi Pembayaran{% endblock %}

{% block content %}
<div class="flex gap-2 mb-4">
    <a href="/laporan/export/rekap?{{ request.query_string }}" class="bg-emerald-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold inline-flex items-center gap-1 hover:bg-emerald-700 transition">
        <i data-lucide="download" class="w-3 h-3"></i> Export Excel
    </a>
</div>
<div class="flex flex-wrap gap-2 mb-4">
    <form method="get" action="/laporan/mutasi" class="flex flex-wrap gap-2">
        <input type="date" name="start_date" value="{{ request.args.get('start_date', '') }}"
            class="w-full sm:w-auto px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
        <input type="date" name="end_date" value="{{ request.args.get('end_date', '') }}"
            class="w-full sm:w-auto px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
        <select name="student_id" class="w-full sm:w-auto px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <option value="">Semua Siswa</option>
            {% for s in students %}
            <option value="{{ s._id }}" {{ 'selected' if request.args.get('student_id') == str(s._id) else '' }}>{{ s.name }}</option>
            {% endfor %}
        </select>
        <select name="status" class="w-full sm:w-auto px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <option value="">Semua Status</option>
            <option value="paid" {{ 'selected' if request.args.get('status') == 'paid' else '' }}>Lunas</option>
            <option value="partial" {{ 'selected' if request.args.get('status') == 'partial' else '' }}>Sebagian</option>
        </select>
        <button type="submit" class="bg-primary-600 text-white px-3 py-1.5 rounded-xl text-xs">Filter</button>
    </form>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="glass rounded-2xl p-4 border border-white/60 shadow-sm">
        <p class="text-xs text-slate-500">Total Transaksi</p>
        <p class="text-2xl font-bold">{{ total_transactions }}</p>
    </div>
    <div class="glass rounded-2xl p-4 border border-white/60 shadow-sm">
        <p class="text-xs text-slate-500">Total Diterima</p>
        <p class="text-2xl font-bold text-green-600">Rp {{ "{:,.0f}".format(total_amount) }}</p>
    </div>
    <div class="glass rounded-2xl p-4 border border-white/60 shadow-sm">
        <p class="text-xs text-slate-500">Lunas Penuh</p>
        <p class="text-2xl font-bold text-primary-600">{{ fully_paid }}</p>
    </div>
</div>

<div class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm">
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">No. Pembayaran</th>
                <th class="text-left px-4 py-3">Tanggal</th>
                <th class="text-left px-4 py-3">Siswa</th>
                <th class="text-right px-4 py-3">Jumlah</th>
                <th class="text-center px-4 py-3">Status</th>
            </tr>
        </thead>
        <tbody>
            {% for p in payments %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3">{{ p.payment_no }}</td>
                <td class="px-4 py-3">{{ p.payment_date.strftime('%d/%m/%Y') if p.payment_date else '-' }}</td>
                <td class="px-4 py-3">{{ p.student.name if p.student else '-' }}</td>
                <td class="px-4 py-3 text-right">Rp {{ "{:,.0f}".format(p.amount_paid) }}</td>
                <td class="px-4 py-3 text-center">
                    <span class="text-xs px-2 py-1 rounded-full {{ 'bg-emerald-100 text-emerald-700' if p.state == 'paid' else 'bg-amber-100 text-amber-700' }}">
                        {{ p.state }}
                    </span>
                </td>
            </tr>
            {% endfor %}
            {% if not payments %}
            <tr><td colspan="5" class="text-center py-8 text-slate-400">Belum ada data mutasi</td></tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}
