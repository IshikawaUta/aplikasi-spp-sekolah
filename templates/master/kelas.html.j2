{% extends "base.html.j2" %}
{% block title %}Master Kelas - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Master Data / Kelas{% endblock %}

{% block content %}
<div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm mb-6">
    <h3 class="font-black text-slate-900 mb-3">Tambah Kelas</h3>
    <form method="post" action="/master/kelas" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="text" name="name" placeholder="Nama Kelas (contoh: X RPL 1)" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        <select name="jenjang" class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
            <option value="X">X</option>
            <option value="XI">XI</option>
            <option value="XII">XII</option>
        </select>
        <input type="number" name="angkatan" placeholder="Angkatan (tahun)" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none"
            value="{{ now().year }}" min="2000" max="2099">
        <select name="academic_year_id" class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
            <option value="">-- Tahun Ajaran --</option>
            {% for ay in academic_years %}
            <option value="{{ ay._id }}" {{ 'selected' if ay.is_active else '' }}>{{ ay.name }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="bg-primary-600 text-white px-4 py-2 rounded-xl hover:bg-slate-900 text-sm font-bold inline-flex items-center gap-1.5">
            <i data-lucide="plus" class="w-4 h-4"></i> Simpan
        </button>
    </form>
</div>

<div class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm">
    <div class="p-4 border-b flex justify-between items-center">
        <h3 class="font-black text-slate-900">Daftar Kelas</h3>
        <form method="get" action="/master/kelas" class="flex flex-wrap gap-2">
            <select name="academic_year_id" class="w-full sm:w-auto px-3 py-1 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="">Semua Tahun Ajaran</option>
                {% for ay in academic_years %}
                <option value="{{ ay._id }}" {{ 'selected' if request.args.get('academic_year_id') == str(ay._id) else '' }}>{{ ay.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="bg-gray-100 px-3 py-1 rounded-xl text-xs hover:bg-gray-200">Filter</button>
        </form>
    </div>
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">Nama Kelas</th>
                <th class="text-left px-4 py-3">Jenjang</th>
                <th class="text-left px-4 py-3">Angkatan</th>
                <th class="text-left px-4 py-3">Tahun Ajaran</th>
                <th class="text-left px-4 py-3">Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for c in classes %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3 text-sm font-medium">{{ c.name }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ c.jenjang }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ c.angkatan }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ get_ay_name(c.academic_year_id, academic_years) }}</td>
                <td class="px-4 py-3 text-sm font-medium">
                    <button onclick="editClass('{{ c._id }}', '{{ escapejs(c.name) }}', '{{ c.jenjang }}', '{{ c.angkatan }}', '{{ c.academic_year_id or '' }}')"
                        class="text-primary-600 hover:text-primary-700 mr-2"><i data-lucide="pencil" class="w-4 h-4"></i></button>
                    <button onclick="confirmDelete('{{ c._id }}', '{{ escapejs(c.name) }}')"
                        class="text-red-600 hover:text-red-800"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                </td>
            </tr>
            {% endfor %}
            {% if not classes %}
            <tr><td colspan="5" class="text-center py-8 text-slate-400">Belum ada data kelas</td></tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>

<div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden overflow-y-auto">
    <div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm w-full max-w-md mx-4">
        <h3 class="font-semibold text-lg mb-4">Edit Kelas</h3>
        <form method="post" id="editForm" class="space-y-3">
            <input type="text" name="name" id="editName" placeholder="Nama Kelas" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <select name="jenjang" id="editJenjang" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="X">X</option><option value="XI">XI</option><option value="XII">XII</option>
            </select>
            <input type="number" name="angkatan" id="editAngkatan" placeholder="Angkatan" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <select name="academic_year_id" id="editAyId" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="">-- Tahun Ajaran --</option>
                {% for ay in academic_years %}
                <option value="{{ ay._id }}">{{ ay.name }}</option>
                {% endfor %}
            </select>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeEditModal()" class="px-4 py-2 border rounded-xl text-sm">Batal</button>
                <button type="submit" class="px-4 py-2 bg-primary-600 text-white rounded-xl text-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>
<form id="deleteForm" method="post" class="hidden"></form>

<script>
function editClass(id, name, jenjang, angkatan, ayId) {
    document.getElementById('editForm').action = '/master/kelas/' + id + '/update';
    document.getElementById('editName').value = name;
    document.getElementById('editJenjang').value = jenjang;
    document.getElementById('editAngkatan').value = angkatan;
    document.getElementById('editAyId').value = ayId;
    document.getElementById('editModal').classList.remove('hidden');
}
function closeEditModal() { document.getElementById('editModal').classList.add('hidden'); }
function confirmDelete(id, name) {
    if (confirm('Hapus kelas "' + name + '"?')) {
        var form = document.getElementById('deleteForm');
        form.action = '/master/kelas/' + id + '/delete';
        form.submit();
    }
}
</script>
<script>lucide.createIcons();</script>
{% endblock %}
