{% extends "base.html.j2" %}
{% block title %}Master Komponen - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Master Data / Komponen Biaya{% endblock %}

{% block content %}
<div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm mb-6">
    <h3 class="font-black text-slate-900 mb-3">Tambah Komponen</h3>
    <form method="post" action="/master/komponen" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="text" name="name" placeholder="Nama Komponen (contoh: SPP Bulanan)" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        <select name="payment_type" class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
            <option value="bulanan">Bulanan</option>
            <option value="semesteran">Semesteran</option>
            <option value="tahunan">Tahunan</option>
            <option value="lainnya">Lainnya</option>
        </select>
        <input type="number" name="default_amount" placeholder="Nominal Default (Rp)" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        <select name="is_active" class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
            <option value="true">Aktif</option>
            <option value="false">Nonaktif</option>
        </select>
        <button type="submit" class="bg-primary-600 text-white px-4 py-2 rounded-xl hover:bg-slate-900 text-sm font-bold inline-flex items-center gap-1.5">
            <i data-lucide="plus" class="w-4 h-4"></i> Simpan
        </button>
    </form>
</div>

<div class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm">
    <div class="p-4 border-b">
        <h3 class="font-black text-slate-900">Daftar Komponen</h3>
    </div>
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">Nama Komponen</th>
                <th class="text-left px-4 py-3">Tipe Pembayaran</th>
                <th class="text-left px-4 py-3">Nominal Default</th>
                <th class="text-left px-4 py-3">Status</th>
                <th class="text-left px-4 py-3">Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for c in components %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3 text-sm font-medium">{{ c.name }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ c.payment_type }}</td>
                <td class="px-4 py-3 text-sm font-medium">Rp {{ "{:,.0f}".format(c.default_amount) }}</td>
                <td class="px-4 py-3">
                    <span class="text-xs px-3 py-1 rounded-xl {{ 'bg-emerald-100 text-emerald-700' if c.is_active else 'bg-slate-100 text-slate-500' }}">
                        {{ 'Aktif' if c.is_active else 'Nonaktif' }}
                    </span>
                </td>
                <td class="px-4 py-3 text-sm font-medium">
                    <button onclick="editComponent('{{ c._id }}', '{{ escapejs(c.name) }}', '{{ c.payment_type }}', '{{ c.default_amount }}', '{{ 'true' if c.is_active else 'false' }}')"
                        class="text-primary-600 hover:text-primary-700 mr-2"><i data-lucide="pencil" class="w-4 h-4"></i></button>
                    <button onclick="confirmDelete('{{ c._id }}', '{{ escapejs(c.name) }}')"
                        class="text-red-600 hover:text-red-800"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                </td>
            </tr>
            {% endfor %}
            {% if not components %}
            <tr><td colspan="5" class="text-center py-8 text-slate-400">Belum ada data komponen</td></tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>

<div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden overflow-y-auto">
    <div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm w-full max-w-md mx-4">
        <h3 class="font-semibold text-lg mb-4">Edit Komponen</h3>
        <form method="post" id="editForm" class="space-y-3">
            <input type="text" name="name" id="editName" placeholder="Nama Komponen" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <select name="payment_type" id="editPaymentType" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="bulanan">Bulanan</option><option value="semesteran">Semesteran</option>
                <option value="tahunan">Tahunan</option><option value="lainnya">Lainnya</option>
            </select>
            <input type="number" name="default_amount" id="editAmount" placeholder="Nominal" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <select name="is_active" id="editActive" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="true">Aktif</option><option value="false">Nonaktif</option>
            </select>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeEditModal()" class="px-4 py-2 border rounded-xl text-sm">Batal</button>
                <button type="submit" class="px-4 py-2 bg-primary-600 text-white rounded-xl text-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>
<form id="deleteForm" method="post" class="hidden"></form>

<script>
function editComponent(id, name, type, amount, active) {
    document.getElementById('editForm').action = '/master/komponen/' + id + '/update';
    document.getElementById('editName').value = name;
    document.getElementById('editPaymentType').value = type;
    document.getElementById('editAmount').value = amount;
    document.getElementById('editActive').value = active;
    document.getElementById('editModal').classList.remove('hidden');
}
function closeEditModal() { document.getElementById('editModal').classList.add('hidden'); }
function confirmDelete(id, name) {
    if (confirm('Hapus komponen "' + name + '"?')) {
        var form = document.getElementById('deleteForm');
        form.action = '/master/komponen/' + id + '/delete';
        form.submit();
    }
}
</script>
<script>lucide.createIcons();</script>
{% endblock %}
