{% extends "base.html.j2" %}
{% block title %}Master Siswa - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Master Data / Siswa{% endblock %}

{% block content %}
{% if error %}
<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm">{{ error }}</div>
{% endif %}

<div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm mb-6">
    <h3 class="font-black text-slate-900 mb-3">Tambah Siswa</h3>
    <form method="post" action="/master/siswa" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-3">
        <input type="text" name="name" placeholder="Nama Lengkap" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        <input type="text" name="nis" placeholder="NIS" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        <select name="class_id" required class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
            <option value="">-- Pilih Kelas --</option>
            {% for c in classes %}
            <option value="{{ c._id }}">{{ c.name }}</option>
            {% endfor %}
        </select>
        <select name="gender" class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none">
            <option value="L">Laki-laki</option>
            <option value="P">Perempuan</option>
        </select>
        <input type="number" name="angkatan" placeholder="Angkatan (tahun)" required
            class="px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none"
            value="{{ now().year }}" min="2000" max="2099">
        <button type="submit" class="bg-primary-600 text-white px-4 py-2 rounded-xl hover:bg-slate-900 text-sm font-bold inline-flex items-center gap-1.5">
            <i data-lucide="plus" class="w-4 h-4"></i> Simpan
        </button>
    </form>
</div>

<div class="glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm">
    <div class="p-4 border-b flex justify-between items-center">
        <h3 class="font-black text-slate-900">Daftar Siswa</h3>
        <div class="flex flex-wrap gap-2 items-center">
        <a href="/laporan/export/siswa" class="bg-emerald-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold inline-flex items-center gap-1 hover:bg-emerald-700 transition">
            <i data-lucide="download" class="w-3 h-3"></i> Export Siswa
        </a>
        <form method="get" action="/master/siswa" class="flex flex-wrap gap-2">
            <select name="class_id" class="w-full sm:w-auto px-3 py-1 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="">Semua Kelas</option>
                {% for c in classes %}
                <option value="{{ c._id }}" {{ 'selected' if request.args.get('class_id') == str(c._id) else '' }}>{{ c.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="bg-gray-100 px-3 py-1 rounded-xl text-xs hover:bg-gray-200">Filter</button>
        </form>
        </div>
    </div>
    <div class="overflow-x-auto -mx-3 px-3">
    <table class="w-full text-sm">
        <thead class="bg-slate-900/5 text-slate-500">
            <tr>
                <th class="text-left px-4 py-3">Nama</th>
                <th class="text-left px-4 py-3">NIS</th>
                <th class="text-left px-4 py-3">Kelas</th>
                <th class="text-left px-4 py-3">JK</th>
                <th class="text-left px-4 py-3">Angkatan</th>
                <th class="text-left px-4 py-3">Aksi</th>
            </tr>
        </thead>
        <tbody>
            {% for s in students %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-3 text-sm font-medium">{{ s.name }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ s.nis }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ get_class_name(s.class_id, classes) }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ 'L' if s.gender == 'L' else 'P' }}</td>
                <td class="px-4 py-3 text-sm font-medium">{{ s.angkatan }}</td>
                <td class="px-4 py-3 text-sm font-medium">
                    <button onclick="editStudent('{{ s._id }}', '{{ escapejs(s.name) }}', '{{ escapejs(s.nis) }}', '{{ s.class_id }}', '{{ s.gender }}', '{{ s.angkatan }}')"
                        class="text-primary-600 hover:text-primary-700 mr-2"><i data-lucide="pencil" class="w-4 h-4"></i></button>
                    <button onclick="confirmDelete('{{ s._id }}', '{{ escapejs(s.name) }}')"
                        class="text-red-600 hover:text-red-800"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                </td>
            </tr>
            {% endfor %}
            {% if not students %}
            <tr><td colspan="6" class="text-center py-8 text-slate-400">Belum ada data siswa</td></tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden overflow-y-auto">
    <div class="glass rounded-[32px] p-6 border border-white/60 shadow-sm w-full max-w-lg mx-4">
        <h3 class="font-semibold text-lg mb-4">Edit Siswa</h3>
        <form method="post" id="editForm" class="space-y-3">
            <input type="text" name="name" id="editName" placeholder="Nama" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <input type="text" name="nis" id="editNis" placeholder="NIS" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <select name="class_id" id="editClassId" required class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                {% for c in classes %}
                <option value="{{ c._id }}">{{ c.name }}</option>
                {% endfor %}
            </select>
            <select name="gender" id="editGender" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                <option value="L">Laki-laki</option>
                <option value="P">Perempuan</option>
            </select>
            <input type="number" name="angkatan" id="editAngkatan" placeholder="Angkatan" required
                class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeEditModal()" class="px-4 py-2 border rounded-xl text-sm">Batal</button>
                <button type="submit" class="px-4 py-2 bg-primary-600 text-white rounded-xl text-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>

<form id="deleteForm" method="post" class="hidden"></form>

<script>
function getClassId(classes, name) { return ''; }
function editStudent(id, name, nis, classId, gender, angkatan) {
    document.getElementById('editForm').action = '/master/siswa/' + id + '/update';
    document.getElementById('editName').value = name;
    document.getElementById('editNis').value = nis;
    document.getElementById('editClassId').value = classId;
    document.getElementById('editGender').value = gender;
    document.getElementById('editAngkatan').value = angkatan;
    document.getElementById('editModal').classList.remove('hidden');
}
function closeEditModal() {
    document.getElementById('editModal').classList.add('hidden');
}
function confirmDelete(id, name) {
    if (confirm('Hapus siswa "' + name + '"? Data terkait tidak akan terhapus.')) {
        var form = document.getElementById('deleteForm');
        form.action = '/master/siswa/' + id + '/delete';
        form.submit();
    }
}
</script>
<script>lucide.createIcons();</script>
{% endblock %}
