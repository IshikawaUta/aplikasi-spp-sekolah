{% extends "base.html.j2" %}
{% block title %}Kwitansi - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Kwitansi Pembayaran{% endblock %}

{% block head_extra %}
<style>
    @media print {
        body * { visibility: hidden; }
        html, body { margin: 0; padding: 0; background: white !important; }
        #kwitansiArea, #kwitansiArea * { visibility: visible; }
        #kwitansiArea { position: absolute; left: 0; top: 0; width: 100%; }
    }
</style>
{% endblock %}

{% block content %}
<div id="kwitansiArea" class="glass rounded-[32px] p-8 border border-white/60 shadow-sm max-w-lg mx-auto">
    <div class="text-center border-b border-dashed border-slate-300 pb-4 mb-4">
        <h2 class="text-xl font-black text-slate-900">{{ config.APP_NAME }}</h2>
        <p class="text-xs text-slate-400">{{ config.APP_ADDRESS }}</p>
        <h3 class="text-lg font-bold text-slate-700 mt-3">KWITANSI PEMBAYARAN</h3>
    </div>

    <div class="space-y-2 text-sm mb-4">
        <div class="flex justify-between">
            <span class="text-slate-400">No. Pembayaran</span>
            <span class="font-semibold text-slate-700">{{ payment.payment_no }}</span>
        </div>
        <div class="flex justify-between">
            <span class="text-slate-400">Tanggal</span>
            <span class="font-semibold text-slate-700">{{ (payment.payment_date.strftime('%d %B %Y') if payment.payment_date else '-') }}</span>
        </div>
        <div class="flex justify-between">
            <span class="text-slate-400">Nama Siswa</span>
            <span class="font-semibold text-slate-700">{{ student.name if student else '-' }}</span>
        </div>
        <div class="flex justify-between">
            <span class="text-slate-400">NIS</span>
            <span class="font-semibold text-slate-700">{{ student.nis if student else '-' }}</span>
        </div>
    </div>

    <table class="w-full text-sm mb-4 border-t border-b border-dashed border-slate-300">
        <thead>
            <tr class="text-left text-xs text-slate-400">
                <th class="py-2">Komponen</th>
                <th class="py-2 text-right">Jumlah</th>
            </tr>
        </thead>
        <tbody>
            {% for d in invoice_details %}
            <tr>
                <td class="py-1.5">{{ d.component }}</td>
                <td class="py-1.5 text-right font-medium">Rp {{ "{:,.0f}".format(d.amount_paid) }}</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr class="border-t border-slate-300 font-bold">
                <td class="py-2">Total</td>
                <td class="py-2 text-right">Rp {{ "{:,.0f}".format(total_bayar) }}</td>
            </tr>
        </tfoot>
    </table>

    <p class="text-xs text-slate-400 text-center">Terima kasih atas pembayaran Anda</p>
</div>

<div class="flex justify-center gap-3 mt-4 no-print">
    <button onclick="window.print()" class="bg-primary-600 text-white px-4 py-2 rounded-xl text-sm inline-flex items-center gap-1.5 font-bold hover:bg-slate-900 transition active:scale-95">
        <i data-lucide="printer" class="w-4 h-4"></i> Cetak
    </button>
</div>

<script>lucide.createIcons();</script>
{% endblock %}
