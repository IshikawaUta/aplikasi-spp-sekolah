{% extends "base.html.j2" %}
{% block title %}Virtual Account - {{ config.APP_NAME }}{% endblock %}
{% block header_title %}Transaksi / Virtual Account{% endblock %}

{% block content %}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="glass rounded-2xl p-4 border border-white/60 shadow-sm">
        <h3 class="font-black text-slate-900 mb-3">Buat Virtual Account</h3>
        <form method="get" action="/pembayaran/virtual-akun" class="space-y-2 mb-4">
            <select name="student_id" class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm" onchange="this.form.submit()">
                <option value="">-- Pilih Siswa --</option>
                {% for s in students %}
                <option value="{{ s._id }}" {{ 'selected' if selected_student_id == str(s._id) else '' }}>{{ s.name }} ({{ s.nis }})</option>
                {% endfor %}
            </select>
        </form>

        {% if selected_student_id %}
        <form method="post" action="/pembayaran/virtual-akun/create" class="space-y-3">
            <input type="hidden" name="student_id" value="{{ selected_student_id }}">

            <div>
                <label class="block text-xs text-slate-500 mb-1">Bank</label>
                <select name="bank_code" required class="w-full px-3 py-2 border border-white/60 bg-white/50 rounded-xl text-sm">
                    {% for code, bank in bank_codes.items() %}
                    <option value="{{ code }}">{{ bank.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="space-y-2 max-h-48 overflow-y-auto">
                {% for inv in unpaid_invoices %}
                <label class="flex items-center border rounded-xl p-2 text-xs cursor-pointer hover:bg-gray-50">
                    <input type="checkbox" name="invoice_ids" value="{{ inv._id }}" checked class="mr-2">
                    <div>
                        <span class="font-medium">{{ inv.component.name if inv.component else '-' }}</span>
                        <span class="text-slate-400"> - {{ inv.period.name if inv.period else '-' }}</span>
                        <br>
                        <span class="text-slate-500">Sisa: Rp {{ "{:,.0f}".format(inv.total_amount - inv.paid_amount) }}</span>
                    </div>
                </label>
                {% endfor %}
                {% if not unpaid_invoices %}
                <p class="text-sm text-slate-400 text-center py-4">Tidak ada tagihan</p>
                {% endif %}
            </div>

            {% if unpaid_invoices %}
            <button type="submit" class="w-full bg-primary-600 text-white py-2 rounded-xl text-sm font-medium inline-flex items-center justify-center gap-1.5">
                <i data-lucide="credit-card" class="w-4 h-4"></i> Buat Virtual Account
            </button>
            {% endif %}
        </form>
        {% endif %}
    </div>

    <div class="lg:col-span-2 glass rounded-[32px] overflow-hidden border border-white/60 shadow-sm">
        <div class="p-4 border-b">
            <h3 class="font-black text-slate-900">Riwayat Virtual Account</h3>
        </div>
        <div class="overflow-x-auto -mx-3 px-3">
        <table class="w-full text-sm">
            <thead class="bg-slate-900/5 text-slate-500">
                <tr>
                    <th class="text-left px-4 py-3">Siswa</th>
                    <th class="text-left px-4 py-3">Bank</th>
                    <th class="text-left px-4 py-3">VA Number</th>
                    <th class="text-right px-4 py-3">Nominal</th>
                    <th class="text-center px-4 py-3">Status</th>
                    <th class="text-left px-4 py-3">Expired</th>
                    <th class="text-left px-4 py-3">Aksi</th>
                </tr>
            </thead>
            <tbody>
                {% for va in vas %}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3">{{ va.student.name if va.student else '-' }}</td>
                    <td class="px-4 py-3 text-xs uppercase">{{ va.bank_code }}</td>
                    <td class="px-4 py-3 font-mono text-xs">{{ va.va_number }}
                        {% if va.biller_code %}<br><span class="text-slate-400">Bill Code: {{ va.biller_code }}</span>{% endif %}
                    </td>
                    <td class="px-4 py-3 text-right">Rp {{ "{:,.0f}".format(va.amount) }}</td>
                    <td class="px-4 py-3 text-center">
                        <span class="text-xs px-2 py-1 rounded-full
                            {{ 'bg-amber-100 text-amber-700' if va.status == 'pending' else '' }}
                            {{ 'bg-emerald-100 text-emerald-700' if va.status == 'paid' else '' }}
                            {{ 'bg-rose-100 text-rose-700' if va.status == 'cancelled' else '' }}
                            {{ 'bg-gray-100 text-slate-500' if va.status == 'expired' else '' }}">
                            {{ va.status }}
                        </span>
                    </td>
                    <td class="px-4 py-3 text-xs">{{ va.expires_at.strftime('%d/%m/%Y %H:%M') if va.expires_at else '-' }}</td>
                    <td class="px-4 py-3">
                        <div class="flex gap-1">
                            {% if va.status == 'pending' %}
                            <form method="post" action="/pembayaran/virtual-akun/{{ va._id }}/mark-paid"
                                onsubmit="return confirm('Tandai sudah dibayar?')">
                                <button class="text-green-600 text-xs hover:text-green-800">Lunas</button>
                            </form>
                            <form method="post" action="/pembayaran/virtual-akun/{{ va._id }}/cancel"
                                onsubmit="return confirm('Batalkan VA?')">
                                <button class="text-red-600 text-xs hover:text-red-800 ml-1">Batal</button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
                {% if not vas %}
                <tr><td colspan="7" class="text-center py-8 text-slate-400">Belum ada Virtual Account</td></tr>
                {% endif %}
            </tbody>
        </table>
        </div>
    </div>
</div>
<script>lucide.createIcons();</script>
{% endblock %}
